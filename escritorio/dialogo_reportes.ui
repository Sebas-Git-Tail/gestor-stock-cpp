<ui version="4.0">
 <class>DialogoReportes</class>
 <widget class="QDialog" name="DialogoReportes">
  <property name="geometry"><rect><x>0</x><y>0</y><width>760</width><height>560</height></rect></property>
  <property name="windowTitle"><string>Reportes y avisos</string></property>
  <layout class="QVBoxLayout" name="layoutPrincipal">
   <item>
    <layout class="QHBoxLayout" name="layoutPeriodo">
     <item><widget class="QLabel" name="labelPeriodo"><property name="text"><string>Período:</string></property><property name="buddy"><cstring>comboPeriodo</cstring></property></widget></item>
     <item><widget class="QComboBox" name="comboPeriodo"/></item>
     <item><widget class="QLabel" name="labelDesde"><property name="text"><string>desde</string></property></widget></item>
     <item><widget class="QDateEdit" name="editDesde"><property name="calendarPopup"><bool>true</bool></property><property name="displayFormat"><string>dd/MM/yyyy</string></property></widget></item>
     <item><widget class="QLabel" name="labelHasta"><property name="text"><string>hasta</string></property></widget></item>
     <item><widget class="QDateEdit" name="editHasta"><property name="calendarPopup"><bool>true</bool></property><property name="displayFormat"><string>dd/MM/yyyy</string></property></widget></item>
     <item><spacer name="espacioPeriodo"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property></spacer></item>
    </layout>
   </item>
   <item>
    <layout class="QGridLayout" name="layoutTotales">
     <item row="0" column="0"><widget class="QLabel" name="tituloVentas"><property name="text"><string>Ventas</string></property></widget></item>
     <item row="0" column="1"><widget class="QLabel" name="tituloCompras"><property name="text"><string>Compras</string></property></widget></item>
     <item row="0" column="2"><widget class="QLabel" name="tituloGanancia"><property name="text"><string>Ganancia estimada</string></property></widget></item>

     </widget>
     <widget class="QWidget" name="pestanaAvisos">
      <attribute name="title"><string>Avisos</string></attribute>
      <layout class="QVBoxLayout" name="layoutAvisos">
       <item><widget class="QLabel" name="labelAvisos"><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item><widget class="QTableWidget" name="tablaAvisos"/></item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::StandardButton::Close</set></property></widget>

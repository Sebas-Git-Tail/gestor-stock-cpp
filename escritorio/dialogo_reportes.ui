     <item row="2" column="1"><widget class="QLabel" name="labelDetalleCompras"/></item>
     <item row="2" column="2"><widget class="QLabel" name="labelDetalleGanancia"><property name="wordWrap"><bool>true</bool></property></widget></item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="pestanas">
     <widget class="QWidget" name="pestanaMasVendidos">
      <attribute name="title"><string>Más vendidos</string></attribute>
